# ==== LLM provider ====
# Model dùng cho toàn bộ crew (ví dụ OpenRouter/Gemini model id)
RESEARCH_REPORT_MODEL=openrouter/openai/gpt-oss-20b:free
# Dùng khi chọn model Gemini
RESEARCH_REPORT_GEMINI_API_KEY=
# Dùng khi chọn model OpenRouter
RESEARCH_REPORT_OPENROUTER_API_KEY=
# Base URL OpenRouter (thường giữ mặc định)
RESEARCH_REPORT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==== Runtime mode ====
# true: gọi API/LLM thật, false: chạy deterministic nội bộ
USE_LIVE_CREWS=false
# true: log chi tiết hơn từ CrewAI
VERBOSE_CREWS=false

# ==== Retrieval providers ====
# Tavily key cho web search lane
TAVILY_API_KEY=
# Độ sâu truy vấn Tavily: basic|advanced|fast|ultra-fast
TAVILY_SEARCH_DEPTH=basic
# SerpAPI key cho Google Scholar lane
SERPAPI_API_KEY=

# ==== Retrieval pressure controls ====
# Số kết quả web tối đa / query
SEARCH_RESULT_LIMIT=5
# Số kết quả scholar tối đa / query
SCHOLAR_RESULT_LIMIT=5
# Giới hạn số agenda items sau planning (0 = không giới hạn)
MAX_AGENDA_ITEMS=0
# true: chạy web+scholar song song; false: chạy tuần tự
DUAL_RESEARCH_PARALLEL=true

# ==== Retry / throttling ====
# Số lần retry cho API call
API_RETRY_ATTEMPTS=3
# Backoff cơ sở (giây) giữa các lần retry
API_RETRY_BACKOFF_SECONDS=1.0
# Khoảng cách tối thiểu (giây) giữa 2 lần gọi LLM
LLM_MIN_INTERVAL_SECONDS=0
# Chỉ có ý nghĩa khi ALLOW_LIVE_FALLBACK=true
FAST_DEGRADE_ON_LIVE_FAILURE=false
# true: live mode lỗi thì cho rơi về fallback; false: dừng flow
ALLOW_LIVE_FALLBACK=false
# Profile an toàn cho free-tier (có thể tự ép lại nhiều giá trị bên trên)
FREE_API_MODE=false

# ==== Hugging Face (cho MinerU model/runtime) ====
# Token HF để tải model private/gated hoặc tránh rate-limit tải model
HUGGINGFACE_HUB_TOKEN=
# Đổi vị trí cache Hugging Face
HF_HOME=
